<Window x:Class="ChrPin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChrPin 设置"
        Width="420"
        Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Padding="24" Background="#F8FAFC">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="ChrPin" FontSize="24" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Margin="0,6,0,0"
                           Text="用全局热键把当前窗口切换为始终置顶。"
                           Foreground="#4B5563" />
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="快捷键" FontWeight="SemiBold" Foreground="#111827" />
                <Grid Margin="0,8,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="CtrlCheckBox" Content="Ctrl" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="AltCheckBox" Grid.Column="1" Content="Alt" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="ShiftCheckBox" Grid.Column="2" Content="Shift" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="WinCheckBox" Grid.Column="3" Content="Win" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <TextBox x:Name="KeyTextBox"
                             Grid.Column="4"
                             Height="30"
                             MaxLength="12"
                             VerticalContentAlignment="Center"
                             ToolTip="例如 P、F8、Space" />
                </Grid>

                <CheckBox x:Name="StartWithWindowsCheckBox" Margin="0,0,0,10" Content="开机启动" />
                <CheckBox x:Name="ShowToastCheckBox" Margin="0,0,0,10" Content="操作后显示提示" />
                <CheckBox x:Name="MinimizeToTrayCheckBox" Content="启动后最小化到托盘" />
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#64748B" />
                <Button Grid.Column="1"
                        Width="86"
                        Height="34"
                        Margin="0,0,10,0"
                        Content="取消"
                        Click="CancelButton_Click" />
                <Button Grid.Column="2"
                        Width="86"
                        Height="34"
                        Content="保存"
                        Click="SaveButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
